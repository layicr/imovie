# Turso / libSQL 数据库连接
# 本地起步：file:./data/local.db（无需任何账号）
# 生产（Vercel）：替换为 libsql://<实例>.turso.io
DATABASE_URL=file:./data/local.db

# Turso 鉴权令牌（仅远程实例需要，本地留空）
TURSO_AUTH_TOKEN=

# 是否将本地 data/local.db 打包进 Serverless 函数
# - 使用本地文件（DATABASE_URL 为 file: 或留空）时：保持默认（不设置或任意非 false 值），
#   由 next.config.mjs 的 outputFileTracingIncludes 把 data/ 打进函数包，否则线上读到空库。
# - 启用 Turso 等远程数据库时：设为 false，跳过本地打包，避免无效体积。
INCLUDE_LOCAL_DB=true

# 站点密码：设置后全站需 HTTP Basic 认证，保护私人观影数据；留空则本地放行
SITE_PASSWORD=
