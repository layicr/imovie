# Turso / libSQL 数据库连接
# 本地起步：file:./data/local.db（无需任何账号）
# 生产（Vercel）：替换为 libsql://<实例>.turso.io
DATABASE_URL=file:./data/local.db

# Turso 鉴权令牌（仅远程实例需要，本地留空）
TURSO_AUTH_TOKEN=

# 站点密码：设置后全站需 HTTP Basic 认证，保护私人观影数据；留空则本地放行
SITE_PASSWORD=

# 限流（中间件固定窗口计数，每 IP 独立）：防爬取/滥用 与 认证防爆破
# 全局请求速率：每 IP 每 60 秒最多请求次数，超出返回 429；留空默认 120
RATE_LIMIT=120
# 认证失败速率：每 IP 每 60 秒最多 Basic 认证失败次数，超出返回 429；留空默认 20
# （仅在设置了 SITE_PASSWORD 时生效）
AUTH_FAIL_LIMIT=20
# iMOVIE 环境变量示例
# 复制本文件为 .env.local 并按实际域名修改。

# 站点公开 URL，用于 SEO 中的 metadataBase、canonical、sitemap、robots 与 JSON-LD。
# 必须包含协议和端口（非 80/443 时），结尾不加斜杠。
# 示例：
#   本地开发：http://localhost:3000
#   生产部署：https://movie.example.com
NEXT_PUBLIC_SITE_URL=https://imovie.lyc.la
